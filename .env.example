# ---------------------------------------------------------------------------
# SignOra configuration — copy to .env and edit. Every value is optional;
# these are the defaults the code already uses. See backend/README.md.
# ---------------------------------------------------------------------------

# --- Python inference backend (read by backend/app/config.py) ---
SIGNORA_MODEL_DIR=./models
SIGNORA_DATA_DIR=./backend/data
SIGNORA_HOST=0.0.0.0
SIGNORA_PORT=8000
SIGNORA_CORS_ORIGINS=["*"]
SIGNORA_PRELOAD_MODELS=false
SIGNORA_MAX_LOADED_MODELS=3
SIGNORA_DEFAULT_SEQUENCE_LENGTH=30
SIGNORA_DEFAULT_IMAGE_SIZE=224
SIGNORA_DEFAULT_VIDEO_FRAMES=8

# --- Dev servers (read by scripts/dev.sh and vite.config.ts) ---
BACKEND_PORT=8000
FRONTEND_PORT=5173
# Where vite proxies /api, /health and /ws. Leave as-is unless the backend
# runs somewhere other than localhost.
SIGNORA_BACKEND_URL=http://127.0.0.1:8000

# --- Vercel (frontend project only) ---
# Default backend URL baked into the build (src/lib/storage.ts). Set to the
# Vercel API project URL, e.g. https://signora-api.vercel.app. Leave unset to
# keep "same origin" (dev proxy / reverse proxy setups).
VITE_BACKEND_URL=
