{
  "name": "react-vite-tailwind",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "dev:all": "./scripts/dev.sh",
    "backend": "uvicorn app.main:app --app-dir backend --host 0.0.0.0 --port 8000 --reload",
    "backend:install": "python3 -m venv backend/.venv && backend/.venv/bin/pip install -r backend/requirements.txt",
    "test:backend": "cd backend && .venv/bin/python -m pytest",
    "inspect:models": "backend/.venv/bin/python backend/scripts/inspect_model.py models"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "clsx": "2.1.1",
    "lucide-react": "^1.52.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "3.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.2",
    "vite-plugin-singlefile": "2.3.0"
  }
}
